---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { profile } from "../../content/profile";
import "../../styles/resume.css";

const base = import.meta.env.BASE_URL;
const baseNoSlash = base.endsWith("/") ? base.slice(0, -1) : base;
const withBase = (p: string) => `${baseNoSlash}${p}`;
---

<BaseLayout lang="ru" title="Резюме — Даниил Стариков" description="Резюме разработчика прикладного ПО и системной автоматизации. Стек: Python, C#, PyQt6, AI APIs, Linux.">
  <!-- Навигация -->
  <nav class="nav">
    <a href={`${baseNoSlash}/ru/`} class="nav-logo">straiko</a>
    <div class="nav-controls">
      <a href={withBase("/Daniil_Starikov_Resume.pdf")} download="Резюме_Стариков_Даниил.pdf" class="nav-btn nav-btn-primary">
        ↓ Скачать PDF
      </a>
      <a href={`${baseNoSlash}/resume/`} class="nav-btn" data-lang-switch="en">EN</a>
      <a href={`${baseNoSlash}/ru/`} class="nav-btn">На главную</a>
      <button id="themeToggle" class="nav-btn" aria-label="Переключить тему">
        <span class="theme-icon">🌙</span>
      </button>
    </div>
  </nav>

  <main class="resume-wrapper">
    <!-- Header -->
    <header class="resume-hero">
      <div class="resume-badge">Инди-разработчик · Open for hire</div>
      <h1 class="resume-name">Стариков Даниил Александрович</h1>
      <p class="resume-role">Инди-разработчик / Python & C# Software Engineer</p>
      <p class="resume-location">📍 г. Москва · Готов к удаленной работе / гибриду</p>

      <div class="resume-contacts">
        <a href="https://t.me/Gram_vvallet" target="_blank" rel="noreferrer" class="contact-pill">
          <span class="contact-icon">✈️</span> Telegram: @Gram_vvallet
        </a>
        <a href="mailto:Daniilstarikov2017@gmail.com" class="contact-pill">
          <span class="contact-icon">✉️</span> Daniilstarikov2017@gmail.com
        </a>
        <a href="https://github.com/Straiko" target="_blank" rel="noreferrer" class="contact-pill">
          <span class="contact-icon">🐙</span> GitHub: @Straiko
        </a>
        <a href="https://straiko.github.io/straiko-me/" target="_blank" rel="noreferrer" class="contact-pill">
          <span class="contact-icon">🌐</span> straiko.github.io/straiko-me
        </a>
      </div>
    </header>

    <!-- О себе -->
    <section class="resume-section">
      <div class="section-badge">О себе</div>
      <div class="resume-card resume-about-card">
        <p>
          <strong>Инди-разработчик и инженер прикладного ПО</strong> с фокусом на <strong>Python</strong> и <strong>C# / .NET</strong>. Создаю и выпускаю самостоятельные законченные продукты: десктопные приложения, Telegram-боты, интеграции с LLM и OCR-сервисы распознавания данных.
        </p>
        <p style="margin-top: 0.75rem;">
          Опыт инди-разработки научил меня брать полную ответственность за продукт на каждом этапе: от архитектуры и проектирования до покрытия автотестами (<strong>105+ тестов на pytest</strong>), статической типизации (<strong>mypy</strong>), автоматической сборки (<strong>CI/CD GitHub Actions</strong>) и дистрибуции под Windows и Linux. Уверенно чувствую себя в среде Linux и при исследовании внутренних механизмов систем через реверс-инжиниринг.
        </p>
      </div>
    </section>

    <!-- Технические навыки -->
    <section class="resume-section">
      <div class="section-badge">Технические навыки</div>
      <div class="skills-layout">
        <div class="skill-box">
          <div class="skill-box-title">💻 Языки программирования</div>
          <div class="skill-box-desc">Python 3.10+, C# (.NET), SQL, JavaScript / TypeScript, Bash, PHP, базовый Rust</div>
        </div>
        <div class="skill-box">
          <div class="skill-box-title">🖥️ Десктоп и системный уровень</div>
          <div class="skill-box-desc">PyQt6, Qt Designer, Win32 API, Linux Input, глобальные хоткеи, буфер обмена, системный трей</div>
        </div>
        <div class="skill-box">
          <div class="skill-box-title">🤖 Аудио, Компьютерное зрение & AI</div>
          <div class="skill-box-desc">Speech Recognition (STT), захват микрофона, OCR (Code128 / QR), OpenAI, Anthropic, Groq, Ollama</div>
        </div>
        <div class="skill-box">
          <div class="skill-box-title">🧪 Тестирование и качество кода</div>
          <div class="skill-box-desc">Pytest (105+ тестов), MyPy (строгая типизация), Ruff, Pre-commit, Git, Conventional Commits</div>
        </div>
        <div class="skill-box">
          <div class="skill-box-title">🚀 CI/CD и дистрибуция</div>
          <div class="skill-box-desc">GitHub Actions, PyInstaller (standalone сборка), Inno Setup (Windows инсталляторы)</div>
        </div>
        <div class="skill-box">
          <div class="skill-box-title">⚙️ Реверс-инжиниринг и движки</div>
          <div class="skill-box-desc">.NET Reflection, анализ сборок Unity (IL/C#), XPath/XML патчинг, модификация движков</div>
        </div>
        <div class="skill-box">
          <div class="skill-box-title">📱 Боты и веб-технологии</div>
          <div class="skill-box-desc">Telegram Bot API (aiogram), Telegram Web Apps (TWA), VK API, Astro, HTML/CSS/JS, React.js</div>
        </div>
        <div class="skill-box">
          <div class="skill-box-title">🗄️ Базы данных и инфраструктура</div>
          <div class="skill-box-desc">Проектирование БД, SQL, 1С:Предприятие 8, Linux (Wayland/X11), сетевые протоколы, VLAN</div>
        </div>
      </div>
    </section>

    <!-- Проекты -->
    <section class="resume-section">
      <div class="section-badge">Проекты и практический опыт</div>
      <div class="projects-stack">

        <!-- Проект 1: Olympus -->
        <article class="resume-card project-entry">
          <div class="project-top">
            <h3 class="project-name">Olympus (fast_trans) — Мультимодальный десктопный ассистент перевода и ввода</h3>
            <span class="project-pill">Python · PyQt6 · CI/CD</span>
          </div>
          <div class="project-sublinks">
            <a href="https://github.com/Straiko/fast_trans" target="_blank" rel="noreferrer">🐙 GitHub репозиторий ↗</a>
            <span class="dot-sep">•</span>
            <a href="https://straiko.github.io/fast_trans/" target="_blank" rel="noreferrer">🌐 Лендинг проекта ↗</a>
          </div>
          <ul class="project-list">
            <li>Спроектировал модульное десктопное приложение для мгновенного инлайн-перевода выделенного текста и голосового ввода с AI-оптимизацией.</li>
            <li>Реализовал кроссплатформенный низкоуровневый перехват глобальных горячих клавиш и бесшовную замену текста в активных окнах любых программ с автоматическим восстановлением буфера обмена.</li>
            <li>Построил аудиопайплайн: автоопределение микрофонов, захват звука, транскрибация речи (STT), AI-исправление оговорок и перевод.</li>
            <li>Обеспечил промышленный стандарт качества: написал <strong>105+ автоматических тестов (pytest)</strong>, настроил строгий анализ типов <strong>MyPy</strong> и линтер <strong>Ruff</strong>.</li>
            <li>Настроил <strong>CI/CD через GitHub Actions</strong> для автосборки standalone исполняемых файлов под Windows/Linux и инсталлятора Inno Setup.</li>
          </ul>
        </article>

        <!-- Проект 2: SHK Bot -->
        <article class="resume-card project-entry">
          <div class="project-top">
            <h3 class="project-name">SHK Bot / @Ozonbratik_bot — Сервис распознавания и генерации штрих-кодов</h3>
            <span class="project-pill">Python · OCR · Bots</span>
          </div>
          <div class="project-sublinks">
            <a href="https://t.me/Ozonbratik_bot" target="_blank" rel="noreferrer">✈️ Запустить в Telegram ↗</a>
            <span class="dot-sep">•</span>
            <a href="https://github.com/Straiko/shk" target="_blank" rel="noreferrer">🐙 GitHub репозиторий ↗</a>
          </div>
          <ul class="project-list">
            <li>Разработал и развернул бота для распознавания и генерации штрих-кодов (Code128) и QR-кодов для складской и товарной логистики.</li>
            <li>Внедрил алгоритмы предобработки изображений и OCR-fallback для надежного считывания даже поврежденных или смазанных кодов.</li>
            <li>Реализовал мультиплатформенных клиентов (Telegram, VK, MAX) и промо-сайт на Astro.</li>
          </ul>
        </article>

        <!-- Проект 3: Unity Modding -->
        <article class="resume-card project-entry">
          <div class="project-top">
            <h3 class="project-name">Моддинг игровых движков и анализ сборок (CryoArsenal)</h3>
            <span class="project-pill">C# · .NET · Unity · Reflection</span>
          </div>
          <ul class="project-list">
            <li>С помощью <strong>.NET Reflection</strong> исследовал закрытое API и внутренние классы сборки <code>Assembly-CSharp.dll</code> для вызова приватных методов и управления состоянием игровых сущностей.</li>
            <li>Разработал расширение с кастомными механиками крио-урона и стазиса, интегрировал кастомные интерфейсы в систему XUI и внедрил патчи данных через XPath.</li>
          </ul>
        </article>

        <!-- Проект 4: AI & Web -->
        <article class="resume-card project-entry">
          <div class="project-top">
            <h3 class="project-name">AI & Web проекты (Proverb Bot, SmartCart TWA, Exam Tickets Bot)</h3>
            <span class="project-pill">LLM · Groq · TWA · JS</span>
          </div>
          <ul class="project-list">
            <li>Создал Telegram-бота с интеграцией LLM через Groq API для смыслового анализа и подбора пословиц.</li>
            <li>Разработал интерактивного бота для сдачи экзаменов по билетам (JS, алгоритмы, ООП) с трекингом прогресса и викторинами.</li>
            <li>Собрал интерактивное мини-приложение <strong>Telegram Web App (TWA)</strong> и персональный сайт-портфолио на фреймворке Astro.</li>
          </ul>
        </article>

      </div>
    </section>

    <!-- Образование -->
    <section class="resume-section">
      <div class="section-badge">Образование</div>
      <div class="resume-card edu-card">
        <div class="edu-header">
          <div>
            <h3 class="edu-title">ГБПОУ МКАГ (Московский колледж архитектуры и градостроительства)</h3>
            <p class="edu-spec">Специальность: 09.02.07 «Информационные системы и программирование»</p>
          </div>
          <div class="edu-year">Москва, Россия</div>
        </div>
        <p class="edu-desc">
          Квалификация: Программист / Разработчик информационных систем (Демонстрационный экзамен КОД 09.02.07-5). Изучение алгоритмов, ООП, проектирования СУБД, прикладных модулей и 1С:Предприятие 8.
        </p>
      </div>
    </section>

    <!-- Скачать PDF футер -->
    <div class="resume-cta-bottom">
      <a href={withBase("/Daniil_Starikov_Resume.pdf")} download="Резюме_Стариков_Даниил.pdf" class="cta-download-btn">
        <svg xmlns="http://www.w3.org/2000/svg" class="cta-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        Скачать резюме в формате PDF
      </a>
    </div>
  </main>

  <footer class="footer">
    <div class="footer-content">
      <p class="footer-copy">© 2026 {profile.fullName} · Резюме</p>
    </div>
  </footer>
</BaseLayout>
