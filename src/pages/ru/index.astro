---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { profile } from "../../content/profile";
import { projects } from "../../content/projects";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
const blogPosts = posts
  .map((post) => {
    const slug = (post.slug ?? post.id).replace(/\.mdx?$/i, "");
    return {
      slug,
      title: post.data.title,
      description: post.data.description,
      pubDate: post.data.pubDate,
      tags: post.data.tags
    };
  })
  .sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());

const skillsMap = [
  { name: "Языки программирования", percent: 45, icon: "💻", tags: ["Python", "JavaScript", "C++", "C", "PHP", "Node.js"] },
  { name: "Веб-технологии", percent: 60, icon: "🌐", tags: ["HTML", "CSS", "SQL", "React.js", "PHP"] },
  { name: "Базы данных", percent: 70, icon: "🗄️", tags: ["SQL", "Моделирование данных", "Проектирование БД"] },
  { name: "Сети и инфраструктура", percent: 40, icon: "🔌", tags: ["Компьютерные сети", "VLAN", "Linux"] },
  { name: "Архитектура и UML", percent: 80, icon: "🏗️", tags: ["UML диаграммы", "Use Cases", "Проектирование систем"] },
  { name: "Инструменты", percent: 40, icon: "🔧", tags: ["Git", "CLI", "Astro", "Node.js"] }
];

const features = [
  {
    icon: "⚡",
    title: "Быстрая разработка",
    desc: "Создание высокопроизводительных приложений с современными фреймворками и чистой архитектурой."
  },
  {
    icon: "🎨",
    title: "Чистый дизайн",
    desc: "Разработка визуально безупречных интерфейсов с вниманием к деталям и пользовательскому опыту."
  },
  {
    icon: "🔧",
    title: "Full Stack",
    desc: "Разработка от проектирования базы данных до реализации фронтенда."
  },
  {
    icon: "🚀",
    title: "Постоянное обучение",
    desc: "Расширение навыков в новых технологиях и методологиях разработки."
  }
];

const base = import.meta.env.BASE_URL;
const baseNoSlash = base.endsWith("/") ? base.slice(0, -1) : base;
---

<BaseLayout lang="ru" title={profile.fullName} description={`${profile.tagline.ru} · ${profile.subtitle.ru}`}>
  <!-- Навигация -->
  <nav class="nav">
    <a href={`${baseNoSlash}/ru/`} class="nav-logo">straiko</a>
    <div class="nav-controls">
      <a href={`${baseNoSlash}/`} class="nav-btn">EN</a>
      <button id="themeToggle" class="nav-btn" aria-label="Переключить тему">
        <span class="theme-icon">🌙</span>
      </button>
    </div>
  </nav>

  <!-- Герой -->
  <section class="hero">
    <div class="hero-badge">Открыт для предложений</div>
    <h1 class="hero-title">Даниил Стариков</h1>
    <p class="hero-subtitle">Студент IT-специальности и разработчик, создающий быстрые, современные и визуально совершенные приложения. Сейчас tập trung vào full-stack разработку и проектирование систем.</p>
    <div class="hero-links">
      <a href="https://github.com/Straiko" target="_blank" rel="noreferrer" class="hero-link">
        GitHub ↗
      </a>
      <a href="mailto:Daniilstarikov2017@gmail.com" class="hero-link hero-link-secondary">
        Связаться
      </a>
    </div>
  </section>

  <!-- Возможности -->
  <section class="features">
    <div class="features-header">
      <h2 class="features-title">Что я делаю</h2>
      <p class="features-subtitle">Создание современных решений с чистым кодом и продуманным дизайном</p>
    </div>
    <div class="features-grid">
      {features.map((f) => (
        <div class="feature-card">
          <div class="feature-icon">{f.icon}</div>
          <h3 class="feature-title">{f.title}</h3>
          <p class="feature-desc">{f.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Проекты -->
  <section class="projects">
    <div class="projects-header">
      <h2 class="projects-title">Проекты</h2>
      <p class="projects-subtitle">Избранные работы и вклад в open source</p>
    </div>
    <div class="projects-grid">
      {projects.map((p) => (
        <div class="project-card">
          {p.badge && <span class="project-badge">{p.badge}</span>}
          <h3 class="project-title">{p.title}</h3>
          <p class="project-desc">{p.description.ru}</p>
          {p.tags && (
            <div class="project-tags">
              {p.tags.map((tag) => (
                <span class="project-tag">{tag}</span>
              ))}
            </div>
          )}
          <div class="project-links">
            <a class="project-link" href={p.href} target="_blank" rel="noreferrer">
              {p.ctaLabel?.ru ?? "открыть →"}
            </a>
            {p.liveUrl && (
              <a class="project-link project-link-live" href={p.liveUrl} target="_blank" rel="noreferrer">
                демо →
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Навыки -->
  <section class="skills">
    <div class="skills-header">
      <h2 class="skills-title">Технические навыки</h2>
      <p class="skills-subtitle">Ключевые компетенции и технологии, с которыми я работаю</p>
    </div>
    <div class="skills-grid">
      {skillsMap.map((sk) => (
        <div class="skill-card">
          <div class="skill-icon">{sk.icon}</div>
          <h3 class="skill-name">{sk.name}</h3>
          <div class="skill-bar">
            <div class="skill-bar-fill" style={`width: ${sk.percent}%`}></div>
          </div>
          <div class="skill-tags">
            {sk.tags.map((tg) => (
              <span class="skill-tag">{tg}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Блог -->
  {blogPosts.length > 0 && (
    <section class="blog">
      <div class="blog-header">
        <h2 class="blog-title">Блог</h2>
        <p class="blog-subtitle">Мысли о разработке и обучении</p>
      </div>
      <div class="blog-list">
        {blogPosts.map((post) => (
          <a href={`${baseNoSlash}/ru/blog/${post.slug}`} class="blog-item">
            <div class="blog-item-header">
              <h3 class="blog-item-title">{post.title}</h3>
              <span class="blog-item-date">{post.pubDate.toLocaleDateString('ru-RU', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
            </div>
            <p class="blog-item-desc">{post.description}</p>
            <div class="blog-item-tags">
              {post.tags?.map((tag) => (
                <span class="blog-tag">{tag}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Терминал -->
  <section class="terminal-section">
    <div class="terminal-header">
      <h2 class="terminal-title">Интерактивный CLI</h2>
      <p class="terminal-subtitle">Введите <strong>help</strong> для просмотра доступных команд</p>
    </div>
    <div class="terminal-window">
      <div class="terminal-topbar">
        <span class="terminal-dot red"></span>
        <span class="terminal-dot yellow"></span>
        <span class="terminal-dot green"></span>
      </div>
      <div id="terminal-body" class="terminal-body">
        <div class="terminal-line terminal-output-accent">Добро пожаловать в CLI Даниила Старикова (v2.1.0)</div>
        <div class="terminal-line">Введите <span class="terminal-output-success">help</span> для просмотра доступных команд.</div>
        <div id="terminal-output-container"></div>
        <div class="terminal-input-line">
          <span class="terminal-prompt">straiko@portfolio:~$</span>
          <input type="text" id="terminal-input" class="terminal-input" autocomplete="off" spellcheck="false" aria-label="Ввод в терминал" />
        </div>
      </div>
    </div>
  </section>

  <!-- Футер -->
  <footer class="footer">
    <div class="footer-content">
      <div class="footer-links">
        <a href="https://github.com/Straiko" target="_blank" rel="noreferrer" class="footer-link">GitHub</a>
        <a href="mailto:Daniilstarikov2017@gmail.com" class="footer-link">Email</a>
        <a href="https://github.com/Straiko?tab=repositories" target="_blank" rel="noreferrer" class="footer-link">Проекты</a>
      </div>
      <p class="footer-copy">© 2026 {profile.fullName}. Все права защищены.</p>
    </div>
  </footer>

  <script is:inline>
    const themeToggle = document.getElementById('themeToggle');
    const themeIcon = themeToggle?.querySelector('.theme-icon');
    const html = document.documentElement;

    const savedTheme = localStorage.getItem('theme') || 'dark';
    html.setAttribute('data-theme', savedTheme);
    if (themeIcon) themeIcon.textContent = savedTheme === 'light' ? '🌙' : '☀️';

    themeToggle?.addEventListener('click', () => {
      const current = html.getAttribute('data-theme');
      const next = current === 'light' ? 'dark' : 'light';
      html.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      if (themeIcon) themeIcon.textContent = next === 'light' ? '🌙' : '☀️';
    });

    document.addEventListener('DOMContentLoaded', () => {
      const termInput = document.getElementById('terminal-input');
      const termOutput = document.getElementById('terminal-output-container');
      const termBody = document.getElementById('terminal-body');

      function writeLine(text, className = '') {
        const line = document.createElement('div');
        line.className = 'terminal-line ' + className;
        line.textContent = text;
        termOutput.appendChild(line);
        termBody.scrollTop = termBody.scrollHeight;
      }

      termInput?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          const cmd = termInput.value.trim().toLowerCase();
          termInput.value = '';
          if (!cmd) return;

          writeLine(`straiko@portfolio:~$ ${cmd}`, 'terminal-input-line');

          switch (cmd) {
            case 'help':
              writeLine('Доступные команды:', 'terminal-output-accent');
              writeLine('  about    - Информация о Данииле Старикове');
              writeLine('  skills   - Список ключевых ИТ-компетенций');
              writeLine('  projects - Обзор разработанных приложений');
              writeLine('  blog     - Последние записи в блоге');
              writeLine('  contact  - Контактные каналы связи');
              writeLine('  clear    - Очистить лог терминала');
              break;
            case 'about':
              writeLine('Имя: Даниил Стариков');
              writeLine('Статус: Студент ИТ-специальности в МКАГ (Москва, Россия)');
              writeLine('Цель: Разработка быстрых, современных и визуально совершенных приложений.');
              break;
            case 'skills':
              writeLine('Ключевые ИТ-компетенции:', 'terminal-output-accent');
              writeLine('  - Языки: Python, JavaScript, C++, C, PHP, Node.js');
              writeLine('  - Веб-технологии: HTML, CSS, SQL, React.js, PHP Backend');
              writeLine('  - Базы данных: SQL, Моделирование данных, Проектирование БД');
              writeLine('  - Сети: Компьютерные сети, VLAN, Linux');
              break;
            case 'projects':
              writeLine('Разработанные проекты:', 'terminal-output-accent');
              writeLine('  [1] Olympus (fast_trans) - Desktop переводчик с AI');
              writeLine('  [2] SHK Bot             - Telegram бот для сканирования');
              writeLine('  [3] easy-php             - Коллекция PHP утилит');
              writeLine('  [4] 2-work-52            - Практические задачи на JavaScript');
              break;
            case 'blog':
              writeLine('Недавние статьи:', 'terminal-output-accent');
              writeLine('  - Starting with Astro');
              writeLine('  - Notes on learning');
              writeLine('  - How I choose projects');
              break;
            case 'contact':
              writeLine('Каналы связи:', 'terminal-output-accent');
              writeLine('  Email: Daniilstarikov2017@gmail.com');
              writeLine('  GitHub: https://github.com/Straiko');
              break;
            case 'clear':
              termOutput.innerHTML = '';
              break;
            default:
              writeLine(`Команда не найдена: "${cmd}". Введите "help" для списка команд.`, 'terminal-output-error');
          }
        }
      });

      document.querySelector('.terminal-window')?.addEventListener('click', () => termInput?.focus());
    });
  </script>
</BaseLayout>
