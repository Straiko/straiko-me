---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { profile } from "../../content/profile";
import { projects } from "../../content/projects";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
const blogPosts = posts
  .map((post) => {
    const slug = (post.slug ?? post.id).replace(/\.mdx?$/i, "");
    return {
      slug,
      title: post.data.title,
      description: post.data.description,
      pubDate: post.data.pubDate,
      tags: post.data.tags
    };
  })
  .sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());

const skillsMap = [
  { name: "Языки программирования", percent: 45, icon: "💻", tags: ["Python", "JavaScript", "C++", "C", "PHP", "Node.js"] },
  { name: "Веб-технологии", percent: 60, icon: "🌐", tags: ["HTML", "CSS", "SQL", "React.js", "PHP"] },
  { name: "Базы данных", percent: 70, icon: "🗄️", tags: ["SQL", "Моделирование данных", "Проектирование БД"] },
  { name: "Сети и инфраструктура", percent: 40, icon: "🔌", tags: ["Компьютерные сети", "VLAN", "Linux"] },
  { name: "Архитектура и UML", percent: 80, icon: "🏗️", tags: ["UML диаграммы", "Use Cases", "Проектирование систем"] },
  { name: "Инструменты", percent: 40, icon: "🔧", tags: ["Git", "CLI", "Astro", "Node.js"] }
];

const features = [
  {
    icon: "⚡",
    title: "Быстрая разработка",
    desc: "Создание высокопроизводительных приложений с современными фреймворками и чистой архитектурой."
  },
  {
    icon: "🎨",
    title: "Чистый дизайн",
    desc: "Разработка визуально безупречных интерфейсов с вниманием к деталям и пользовательскому опыту."
  },
  {
    icon: "🔧",
    title: "Full Stack",
    desc: "Разработка от проектирования базы данных до реализации фронтенда."
  },
  {
    icon: "🚀",
    title: "Постоянное обучение",
    desc: "Расширение навыков в новых технологиях и методологиях разработки."
  }
];

const base = import.meta.env.BASE_URL;
const baseNoSlash = base.endsWith("/") ? base.slice(0, -1) : base;
---

<BaseLayout lang="ru" title={profile.fullName} description={`${profile.tagline.ru} · ${profile.subtitle.ru}`}>
  <!-- Навигация -->
  <nav class="nav">
    <a href={`${baseNoSlash}/ru/`} class="nav-logo">straiko</a>
    <div class="nav-controls">
      <a href={`${baseNoSlash}/ru/resume/`} class="nav-btn">Резюме</a>
      <a href={`${baseNoSlash}/`} class="nav-btn">EN</a>
      <button id="themeToggle" class="nav-btn" aria-label="Переключить тему">
        <span class="theme-icon">🌙</span>
      </button>
    </div>
  </nav>

  <!-- Герой -->
  <section class="hero">
    <div class="hero-badge">Инди-разработчик · Open for hire</div>
    <h1 class="hero-title">Даниил Стариков</h1>
    <p class="hero-subtitle">Инди-разработчик и Software Engineer. Создаю законченные продукты полного цикла: от проектирования архитектуры и 100+ автотестов до продакшн-сборки и релиза. Специализируюсь на Python, десктопе, автоматизации, системной интеграции и C#.</p>
    <div class="hero-links">
      <a href={`${baseNoSlash}/ru/resume/`} class="hero-link">
        📄 Резюме / CV
      </a>
      <a href="https://t.me/Gram_vvallet" target="_blank" rel="noreferrer" class="hero-link hero-link-secondary">
        Telegram ↗
      </a>
      <a href="https://github.com/Straiko" target="_blank" rel="noreferrer" class="hero-link hero-link-secondary">
        GitHub ↗
      </a>
      <a href="mailto:Daniilstarikov2017@gmail.com" class="hero-link hero-link-secondary">
        Связаться
      </a>
    </div>
  </section>

  <!-- Возможности -->
  <section class="features">
    <div class="features-header">
      <h2 class="features-title">Что я делаю</h2>
      <p class="features-subtitle">Создание современных решений с чистым кодом и продуманным дизайном</p>
    </div>
    <div class="features-grid">
      {features.map((f) => (
        <div class="feature-card">
          <div class="feature-icon">{f.icon}</div>
          <h3 class="feature-title">{f.title}</h3>
          <p class="feature-desc">{f.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Проекты -->
  <section class="projects">
    <div class="projects-header">
      <h2 class="projects-title">Проекты</h2>
      <p class="projects-subtitle">Избранные работы и вклад в open source</p>
    </div>
    <div class="projects-grid">
      {projects.map((p) => (
        <div class="project-card">
          {p.badge && <span class="project-badge">{p.badge}</span>}
          <h3 class="project-title">{p.title}</h3>
          <p class="project-desc">{p.description.ru}</p>
          {p.tags && (
            <div class="project-tags">
              {p.tags.map((tag) => (
                <span class="project-tag">{tag}</span>
              ))}
            </div>
          )}
          <div class="project-links">
            <a class="project-link" href={p.href} target="_blank" rel="noreferrer">
              {p.ctaLabel?.ru ?? "открыть →"}
            </a>
            {p.liveUrl && (
              <a class="project-link project-link-live" href={p.liveUrl} target="_blank" rel="noreferrer">
                демо →
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Навыки -->
  <section class="skills">
    <div class="skills-header">
      <h2 class="skills-title">Технические навыки</h2>
      <p class="skills-subtitle">Ключевые компетенции и технологии, с которыми я работаю</p>
    </div>
    <div class="skills-grid">
      {skillsMap.map((sk) => (
        <div class="skill-card">
          <div class="skill-icon">{sk.icon}</div>
          <h3 class="skill-name">{sk.name}</h3>
          <div class="skill-bar">
            <div class="skill-bar-fill" style={`width: ${sk.percent}%`}></div>
          </div>
          <div class="skill-tags">
            {sk.tags.map((tg) => (
              <span class="skill-tag">{tg}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Блог -->
  {blogPosts.length > 0 && (
    <section class="blog">
      <div class="blog-header">
        <h2 class="blog-title">Блог</h2>
        <p class="blog-subtitle">Мысли о разработке и обучении</p>
      </div>
      <div class="blog-list">
        {blogPosts.map((post) => (
          <a href={`${baseNoSlash}/ru/blog/${post.slug}`} class="blog-item">
            <div class="blog-item-header">
              <h3 class="blog-item-title">{post.title}</h3>
              <span class="blog-item-date">{post.pubDate.toLocaleDateString('ru-RU', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
            </div>
            <p class="blog-item-desc">{post.description}</p>
            <div class="blog-item-tags">
              {post.tags?.map((tag) => (
                <span class="blog-tag">{tag}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Для работодателей -->
  <section class="hiring-section">
    <div class="hiring-header">
      <div class="hiring-pill">Готов к работе</div>
      <h2 class="hiring-title">Что я привношу в команду</h2>
      <p class="hiring-subtitle">Почему работодатели выбирают мои решения: инженерная надежность, автономия и ориентация на результат</p>
    </div>

    <!-- Метрики качества -->
    <div class="hiring-metrics">
      <div class="metric-card">
        <div class="metric-num">105+</div>
        <div class="metric-label">Автотестов (pytest)</div>
        <div class="metric-sub">100% pass rate в десктоп-проекте</div>
      </div>
      <div class="metric-card">
        <div class="metric-num">Type-Safe</div>
        <div class="metric-label">Строгая типизация</div>
        <div class="metric-sub">MyPy + Ruff в CI/CD пайплайне</div>
      </div>
      <div class="metric-card">
        <div class="metric-num">CI/CD</div>
        <div class="metric-label">Автосборка релизов</div>
        <div class="metric-sub">Standalone бинарники и инсталляторы</div>
      </div>
      <div class="metric-card">
        <div class="metric-num">Full-Cycle</div>
        <div class="metric-label">От идеи до деплоя</div>
        <div class="metric-sub">Архитектура, GUI, БД, API и дистрибуция</div>
      </div>
    </div>

    <!-- Преимущества для работодателя -->
    <div class="hiring-grid">
      <div class="hiring-card">
        <div class="hiring-icon">🎯</div>
        <h3 class="hiring-card-title">Инженерная дисциплина</h3>
        <p class="hiring-card-desc">
          Не пишу спагетти-код «ради фичи». Проектирую расширяемую архитектуру, разделяю слои ответственности, документирую код и всегда закрываю функционал тестами.
        </p>
      </div>

      <div class="hiring-card">
        <div class="hiring-icon">⚡</div>
        <h3 class="hiring-card-title">Решение реальных бизнес-задач</h3>
        <p class="hiring-card-desc">
          Опыт создания прикладных сервисов: OCR-сканирование штрих-кодов для логистики, Telegram-боты с интеграцией LLM, аудио-пайплайны и системные утилиты.
        </p>
      </div>

      <div class="hiring-card">
        <div class="hiring-icon">🔬</div>
        <h3 class="hiring-card-title">Низкоуровневое понимание систем</h3>
        <p class="hiring-card-desc">
          Понимаю, как ОС и рантайм работают «под капотом»: глобальные системные хуки, работа с памятью и декомпиляция сборок через .NET Reflection.
        </p>
      </div>

      <div class="hiring-card">
        <div class="hiring-icon">🤝</div>
        <h3 class="hiring-card-title">Быстрый онбординг и самостоятельность</h3>
        <p class="hiring-card-desc">
          Умею разбираться в закрытых API и чужих кодовых базах без лишних вопросов. Готов быстро погрузиться в процессы команды и выполнить тестовое задание.
        </p>
      </div>
    </div>

    <!-- Призыв к действию -->
    <div class="hiring-cta">
      <div class="hiring-cta-content">
        <h3 class="hiring-cta-title">Ищете сильного разработчика в команду?</h3>
        <p class="hiring-cta-desc">Готов обсудить задачи на Full-time (удаленно или гибрид в Москве).</p>
      </div>
      <div class="hiring-cta-buttons">
        <a href="https://t.me/Gram_vvallet" target="_blank" rel="noreferrer" class="cta-btn cta-btn-tg">
          Написать в Telegram ↗
        </a>
        <a href={`${baseNoSlash}/ru/resume/`} class="cta-btn cta-btn-resume">
          Посмотреть резюме
        </a>
      </div>
    </div>
  </section>

  <!-- Футер -->
  <footer class="footer">
    <div class="footer-content">
      <div class="footer-links">
        <a href="https://t.me/Gram_vvallet" target="_blank" rel="noreferrer" class="footer-link">Telegram</a>
        <a href="https://github.com/Straiko" target="_blank" rel="noreferrer" class="footer-link">GitHub</a>
        <a href="mailto:Daniilstarikov2017@gmail.com" class="footer-link">Email</a>
        <a href={`${baseNoSlash}/ru/resume/`} class="footer-link">Резюме</a>
      </div>
      <p class="footer-copy">© 2026 {profile.fullName}. Все права защищены.</p>
    </div>
  </footer>

  <script is:inline>
    const themeToggle = document.getElementById('themeToggle');
    const themeIcon = themeToggle?.querySelector('.theme-icon');
    const html = document.documentElement;

    const savedTheme = localStorage.getItem('theme') || 'dark';
    html.setAttribute('data-theme', savedTheme);
    if (themeIcon) themeIcon.textContent = savedTheme === 'light' ? '🌙' : '☀️';

    themeToggle?.addEventListener('click', () => {
      const current = html.getAttribute('data-theme');
      const next = current === 'light' ? 'dark' : 'light';
      html.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      if (themeIcon) themeIcon.textContent = next === 'light' ? '🌙' : '☀️';
    });
  </script>
</BaseLayout>
