---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { profile } from "../../content/profile";
import { projects } from "../../content/projects";
import { getCollection } from "astro:content";

// Query and sort blog posts dynamically
const posts = await getCollection("blog");
const blogPosts = posts
  .map((post) => {
    const slug = (post.slug ?? post.id).replace(/\.mdx?$/i, "");
    return {
      slug,
      title: post.data.title,
      description: post.data.description,
      pubDate: post.data.pubDate,
      tags: post.data.tags
    };
  })
  .sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());

const skillsMap = [
  { name: "Языки программирования", percent: 45, icon: "💻", tags: ["Python", "JavaScript", "C++", "C", "PHP", "Node.js"] },
  { name: "Веб-технологии", percent: 35, icon: "🌐", tags: ["HTML", "CSS", "SQL", "React.js", "PHP backend"] },
  { name: "Базы данных и проектирование", percent: 30, icon: "🗄️", tags: ["SQL", "Моделирование данных", "Проектирование БД"] },
  { name: "Сети и инфраструктура", percent: 40, icon: "🔌", tags: ["Компьютерные сети", "VLAN", "Сетевое оборудование", "FAT/NTFS", "Linux/OS"] },
  { name: "Архитектура и UML", percent: 30, icon: "🏗️", tags: ["UML диаграммы", "Use Cases", "Проектирование систем"] },
  { name: "Инструменты", percent: 40, icon: "🔧", tags: ["Git", "Администрирование ИС", "CLI", "Astro"] }
];
---

<BaseLayout lang="ru" title={profile.fullName} description={`${profile.tagline.ru} · ${profile.subtitle.ru}`}>
	<div class="home-container">
		<!-- Hero Section -->
		<section class="hero">
			<header class="hero-header">
				<div class="logo">straiko</div>
				<div class="header-controls">
					<a href={`${import.meta.env.BASE_URL}`} class="lang-toggle" aria-label="Switch to English">EN</a>
					<button id="themeToggle" class="theme-toggle" aria-label="Переключить тему">
						<span class="theme-icon">🌙</span>
					</button>
				</div>
			</header>

			<div class="hero-profile">
				<div class="profile-image-container">
					<!-- High-end Terminal SVG Graphic -->
					<svg class="profile-avatar-graphic" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
						<circle cx="50" cy="50" r="46" stroke="currentColor" stroke-width="2" stroke-dasharray="4 4" opacity="0.3" />
						<path d="M30 40L45 50L30 60" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
						<line x1="52" y1="60" x2="72" y2="60" stroke="currentColor" stroke-width="6" stroke-linecap="round" />
					</svg>
				</div>
				<div class="profile-text">
					<h1 class="profile-name">{profile.fullName}</h1>
					<div class="social-links">
						{profile.links.map((l) => (
							<a class="social-icon" href={l.href} target="_blank" rel="noreferrer" aria-label={l.label}>
								{l.label}
							</a>
						))}
					</div>
					<p class="profile-role">{profile.tagline.ru}</p>
					<p class="profile-description">{profile.subtitle.ru}</p>
					<p class="profile-location">
						<span class="location-icon">📍</span> {profile.location.ru}
					</p>
				</div>
			</div>
		</section>

		<!-- Bento Grid -->
		<div class="bento-grid initial-state" id="bentoGrid" role="region" aria-label="Портфолио секции">
			<!-- About me folder -->
			<div class="bento-item item-about folder-item" tabindex="0" data-folder="about" role="button" aria-expanded="false" aria-controls="aboutContent" aria-label="Открыть раздел обо мне">
				<div class="folder-tab">Обо мне</div>
			</div>

			<!-- About me expanded content: Interactive Skills Dashboard in Russian -->
			<div class="folder-content about-content" id="aboutContent" style="display: none;" role="region" aria-label="Информация обо мне">
				<div class="skills-dashboard">
					<!-- Education -->
					<div class="skills-category">
						<div class="skills-header-row">
							<span class="skills-header-icon">🎓</span>
							<h3 class="skills-header-title">Образование</h3>
						</div>
						<div class="skills-grid-new">
							<div class="skill-visual-card" style="display: flex; gap: 1rem; align-items: center;">
								<span style="font-size: 2.25rem;">🏫</span>
								<div>
									<h4 class="card-title">МКАГ</h4>
									<p class="card-subtitle">Студент ИТ-специальности (Информационные системы и программирование)</p>
								</div>
							</div>
						</div>
					</div>

					<!-- Visual Skills Matrix -->
					<div class="skills-category">
						<div class="skills-header-row">
							<span class="skills-header-icon">⚡</span>
							<h3 class="skills-header-title">Матрица навыков</h3>
						</div>
						<div class="skills-grid-new">
							{skillsMap.map((sk) => (
								<div class="skill-visual-card">
									<div class="skill-info">
										<span class="skill-name">{sk.icon} {sk.name}</span>
										<span class="skill-percent">{sk.percent}%</span>
									</div>
									<div class="skill-bar-bg">
										<div class="skill-bar-fill" style={`width: ${sk.percent}%`}></div>
									</div>
									<div class="skill-tags-inline">
										{sk.tags.map((tg) => (
											<span class="skill-tag-micro">{tg}</span>
										))}
									</div>
								</div>
							))}
						</div>
					</div>
				</div>
			</div>

			<!-- Projects folder -->
			<div class="bento-item item-projects folder-item" tabindex="0" data-folder="projects" role="button" aria-expanded="false" aria-controls="projectsContent" aria-label="Открыть раздел проектов">
				<div class="folder-tab">Проекты</div>
			</div>

			<!-- Projects expanded content -->
			<div class="folder-content projects-content" id="projectsContent" style="display: none;" role="region" aria-label="Мои проекты">
				<div class="projects-list">
					{projects.map((p) => (
						<div class="project-item">
							<div class="project-header">
								<h3 class="project-title">{p.title}</h3>
								{p.badge && <span class="project-badge">{p.badge}</span>}
							</div>
							<p class="project-description">{p.description.ru}</p>
							{p.tags && (
								<div class="project-tags-list">
									{p.tags.map((tag) => (
										<span class="project-tag-item">{tag}</span>
									))}
								</div>
							)}
							<a class="project-link" href={p.href} target="_blank" rel="noreferrer">
								{p.ctaLabel?.ru ?? "открыть →"}
							</a>
						</div>
					))}
				</div>
			</div>

			<!-- Blog folder -->
			<div class="bento-item item-blog folder-item" tabindex="0" data-folder="blog" role="button" aria-expanded="false" aria-controls="blogContent" aria-label="Открыть раздел блога">
				<div class="folder-tab">Блог</div>
			</div>

			<!-- Blog expanded content -->
			<div class="folder-content blog-content" id="blogContent" style="display: none;" role="region" aria-label="Статьи блога">
				<div class="blog-list">
					{blogPosts.map((post) => (
						<a href={`${import.meta.env.BASE_URL}/ru/blog/${post.slug}`} class="blog-item">
							<div class="blog-item-header">
								<h3 class="blog-item-title">{post.title}</h3>
								<span class="blog-item-date">{post.pubDate.toLocaleDateString('ru-RU', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
							</div>
							<p class="blog-item-description">{post.description}</p>
							<div class="blog-item-tags">
								{post.tags?.map((tag) => (
									<span class="blog-tag">{tag}</span>
								))}
							</div>
						</a>
					))}
				</div>
			</div>

			<!-- Retro Terminal folder -->
			<div class="bento-item item-terminal folder-item" tabindex="0" data-folder="terminal" role="button" aria-expanded="false" aria-controls="terminalContent" aria-label="Открыть консольный терминал">
				<div class="folder-tab">Терминал</div>
			</div>

			<!-- Retro Terminal expanded content -->
			<div class="folder-content terminal-content" id="terminalContent" style="display: none;" role="region" aria-label="Интерактивный консольный терминал">
				<div class="terminal-window">
					<div class="terminal-topbar">
						<div class="terminal-controls">
							<span class="terminal-dot red"></span>
							<span class="terminal-dot yellow"></span>
							<span class="terminal-dot green"></span>
						</div>
						<div class="terminal-title">straiko@portfolio:~</div>
						<div style="width: 42px;"></div>
					</div>
					<canvas id="terminal-matrix" class="terminal-matrix-canvas"></canvas>
					<div id="terminal-body" class="terminal-body">
						<div class="terminal-line terminal-output-accent">Добро пожаловать в интерактивный CLI Даниила Старикова (v2.1.0)</div>
						<div class="terminal-line">Введите <span class="terminal-output-success">help</span> для просмотра доступных команд.</div>
						<div id="terminal-output-container"></div>
						<div class="terminal-input-line">
							<span class="terminal-prompt">straiko@portfolio:~$</span>
							<div class="terminal-caret-wrapper">
								<input type="text" id="terminal-input" class="terminal-input" autocomplete="off" spellcheck="false" aria-label="Ввод в терминал" />
								<span id="terminal-caret" class="terminal-caret"></span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Footer -->
		<footer class="contact">
			<div class="contact-content">
				<div class="footer-info">
					<p class="copyright">© 2026 {profile.fullName}</p>
				</div>
			</div>
		</footer>
	</div>

	<script is:inline>
		// Theme toggle
		const themeToggle = document.getElementById('themeToggle');
		const themeIcon = themeToggle?.querySelector('.theme-icon');
		const html = document.documentElement;

		const savedTheme = localStorage.getItem('theme') || 'dark';
		html.setAttribute('data-theme', savedTheme);
		if (themeIcon) {
			themeIcon.textContent = savedTheme === 'light' ? '🌙' : '☀️';
		}

		themeToggle?.addEventListener('click', () => {
			const currentTheme = html.getAttribute('data-theme');
			const newTheme = currentTheme === 'light' ? 'dark' : 'light';

			html.setAttribute('data-theme', newTheme);
			localStorage.setItem('theme', newTheme);

			if (themeIcon) {
				themeIcon.textContent = newTheme === 'light' ? '🌙' : '☀️';
			}
		});

		// Folder toggle functionality (with keyboard accessibility)
		document.addEventListener('DOMContentLoaded', () => {
			const grid = document.getElementById('bentoGrid');
			const folders = document.querySelectorAll('.folder-item');
			let currentOpen = null;

			const toggleFolder = (folder) => {
				const folderType = folder.getAttribute('data-folder');
				const content = document.getElementById(`${folderType}Content`);

				if (currentOpen === folderType) {
					if (content) content.style.display = 'none';
					if (grid) {
						grid.classList.remove('expanded-state');
						grid.classList.add('initial-state');
					}
					folder.setAttribute('aria-expanded', 'false');
					currentOpen = null;
				} else {
					if (currentOpen) {
						const prevContent = document.getElementById(`${currentOpen}Content`);
						if (prevContent) prevContent.style.display = 'none';
						const prevFolder = document.querySelector(`[data-folder="${currentOpen}"]`);
						if (prevFolder) prevFolder.setAttribute('aria-expanded', 'false');
					}

					if (content) content.style.display = 'block';
					if (grid) {
						grid.classList.remove('initial-state');
						grid.classList.add('expanded-state');
					}
					folder.setAttribute('aria-expanded', 'true');
					currentOpen = folderType;

					// Focus terminal input if terminal is opened
					if (folderType === 'terminal') {
						setTimeout(() => {
							document.getElementById('terminal-input')?.focus();
						}, 100);
					}
				}
			};

			folders.forEach(folder => {
				folder.addEventListener('click', () => {
					toggleFolder(folder);
				});

				folder.addEventListener('keydown', (e) => {
					if (e.key === 'Enter' || e.key === ' ') {
						e.preventDefault();
						toggleFolder(folder);
					}
				});
			});

			// Retro Terminal Functionality (Russian localization)
			const termInput = document.getElementById('terminal-input');
			const termOutput = document.getElementById('terminal-output-container');
			const termWindow = document.getElementById('terminal-body');
			const termMatrix = document.getElementById('terminal-matrix');

			let matrixInterval = null;

			function handleMatrix() {
				if (matrixInterval) {
					clearInterval(matrixInterval);
					matrixInterval = null;
					const ctx = termMatrix.getContext('2d');
					ctx.clearRect(0, 0, termMatrix.width, termMatrix.height);
					return "Матричный дождь деактивирован.";
				} else {
					const ctx = termMatrix.getContext('2d');
					termMatrix.width = termMatrix.parentElement.offsetWidth;
					termMatrix.height = 380;
					
					const chars = '01010101ABCDEFGHIJKLMNOPQRSTUVWXYZｱｲｳｴｵｶｷｸｹｺ'.split('');
					const fontSize = 14;
					const columns = termMatrix.width / fontSize;
					const rainDrops = Array(Math.floor(columns)).fill(1);
					
					ctx.font = fontSize + 'px monospace';
					
					function draw() {
						ctx.fillStyle = 'rgba(2, 6, 23, 0.05)';
						ctx.fillRect(0, 0, termMatrix.width, termMatrix.height);
						ctx.fillStyle = '#06b6d4';
						
						for (let i = 0; i < rainDrops.length; i++) {
							const text = chars[Math.floor(Math.random() * chars.length)];
							ctx.fillText(text, i * fontSize, rainDrops[i] * fontSize);
							
							if (rainDrops[i] * fontSize > termMatrix.height && Math.random() > 0.975) {
								rainDrops[i] = 0;
							}
							rainDrops[i]++;
						}
					}
					
					matrixInterval = setInterval(draw, 30);
					return "Цифровой дождь матрицы запущен! Напишите matrix повторно для закрытия.";
				}
			}

			function writeLine(text, className = '') {
				const line = document.createElement('div');
				line.className = 'terminal-line ' + className;
				line.textContent = text;
				termOutput.appendChild(line);
				termWindow.scrollTop = termWindow.scrollHeight;
			}

			termInput?.addEventListener('keydown', (e) => {
				if (e.key === 'Enter') {
					const cmdVal = termInput.value.trim();
					termInput.value = '';
					
					if (!cmdVal) return;
					
					writeLine(`straiko@portfolio:~$ ${cmdVal}`, 'terminal-input-line');
					
					const args = cmdVal.toLowerCase().split(' ');
					const cmd = args[0];
					
					switch (cmd) {
						case 'help':
							writeLine('Доступные команды:', 'terminal-output-accent');
							writeLine('  about    - Информация о Данииле Старикове');
							writeLine('  skills   - Список ключевых ИТ-компетенций');
							writeLine('  projects - Обзор разработанных приложений и ссылки на GitHub');
							writeLine('  blog     - Последние записи и статьи в блоге');
							writeLine('  contact  - Контактные каналы связи');
							writeLine('  matrix   - Переключение цифрового дождя матрицы');
							writeLine('  clear    - Очистить лог терминала');
							break;
						case 'about':
							writeLine('Имя: Даниил Стариков');
							writeLine('Статус: Студент ИТ-специальности в МКАГ (Москва, Россия)');
							writeLine('Цель: Разработка производительных, красивых и визуально совершенных систем.');
							break;
						case 'skills':
							writeLine('Ключевые ИТ-компетенции:', 'terminal-output-accent');
							writeLine('  - Языки: Python, JavaScript, C++, C, PHP, Node.js (45%)');
							writeLine('  - Веб-технологии: HTML, CSS, SQL, React.js, PHP Backend (35%)');
							writeLine('  - Базы данных: Проектирование БД, оптимизация запросов SQL (30%)');
							writeLine('  - Сети: Компьютерные сети, VLAN, файловые системы (FAT/NTFS) (40%)');
							break;
						case 'projects':
							writeLine('Разработанные проекты:', 'terminal-output-accent');
							writeLine('  [1] Olympus (fast_trans) - Desktop приложение для мгновенного перевода с AI');
							writeLine('  [2] easy-php             - Коллекция backend утилит на PHP');
							writeLine('  [3] 2-work-52            - Практические задачи и песочница на JavaScript');
							writeLine('Для открытия перейдите по ссылкам во вкладке "Проекты".');
							break;
						case 'blog':
							writeLine('Недавние статьи в блоге:', 'terminal-output-accent');
							writeLine('  - Starting with Astro   (Май 2026)');
							writeLine('  - Notes on learning     (Апрель 2026)');
							writeLine('  - How I choose projects (Март 2026)');
							break;
						case 'contact':
							writeLine('Контакты для связи:', 'terminal-output-accent');
							writeLine('  Email: Daniilstarikov2017@gmail.com');
							writeLine('  GitHub: https://github.com/Straiko');
							break;
						case 'matrix':
							const res = handleMatrix();
							writeLine(res, 'terminal-output-success');
							break;
						case 'clear':
							termOutput.innerHTML = '';
							break;
						default:
							writeLine(`Команда не найдена: "${cmd}". Введите "help" для получения списка команд.`, 'terminal-output-error');
					}
				}
			});

			// Click terminal body to focus input
			document.querySelector('.terminal-window')?.addEventListener('click', () => {
				termInput?.focus();
			});
		});
	</script>
</BaseLayout>
