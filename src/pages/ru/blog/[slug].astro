---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => {
    const slug = (post.slug ?? post.id).replace(/\.mdx?$/i, "");
    return { params: { slug }, props: { post } };
  });
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;
const baseNoTrail = base.endsWith("/") ? base.slice(0, -1) : base;
const withBase = (p) => `${baseNoTrail}${p}`;
const assetSrc = (src) => (src?.startsWith("/") ? withBase(src) : src);
---

<BaseLayout lang="ru" title={post.data.title} description={post.data.description}>
	<div class="min-h-screen">
		<article class="blog-post">
			<header class="post-header">
				<a class="back-link" href={withBase("/ru/")}>← Назад на главную</a>
				<h1 class="post-title">{post.data.title}</h1>
				<div class="post-meta">
					<time datetime={post.data.pubDate.toISOString()}>
						{post.data.pubDate.toLocaleDateString("ru-RU", { year: "numeric", month: "long", day: "numeric" })}
					</time>
					{post.data.tags?.length ? (
						<div class="post-tags">
							{post.data.tags.map((t) => (
								<span class="tag">{t}</span>
							))}
						</div>
					) : null}
				</div>
				{post.data.hero ? (
					<img class="post-hero" src={assetSrc(post.data.hero.src)} alt={post.data.hero.alt} />
				) : null}
			</header>

			<div class="markdown">
				<Content />
			</div>
		</article>
	</div>
</BaseLayout>
