---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../content/profile";
import { projects } from "../content/projects";
import { getCollection } from "astro:content";

const posts = await getCollection("blog-en");
const blogPosts = posts
  .map((post) => {
    const slug = (post.slug ?? post.id).replace(/\.mdx?$/i, "");
    return {
      slug,
      title: post.data.title,
      description: post.data.description,
      pubDate: post.data.pubDate,
      tags: post.data.tags
    };
  })
  .sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());

const skillsMap = [
  { name: "Programming Languages", percent: 45, icon: "💻", tags: ["Python", "JavaScript", "C++", "C", "PHP", "Node.js"] },
  { name: "Web Technologies", percent: 60, icon: "🌐", tags: ["HTML", "CSS", "SQL", "React.js", "PHP"] },
  { name: "Databases & Design", percent: 70, icon: "🗄️", tags: ["SQL", "Data Modeling", "Database Design"] },
  { name: "Networks & Infrastructure", percent: 40, icon: "🔌", tags: ["Computer Networks", "VLAN", "Hardware", "Linux"] },
  { name: "Architecture & UML", percent: 80, icon: "🏗️", tags: ["UML Diagrams", "Use Cases", "System Design"] },
  { name: "Dev Tools", percent: 40, icon: "🔧", tags: ["Git", "CLI Tools", "Astro", "Node.js"] }
];

const features = [
  {
    icon: "⚡",
    title: "Fast Development",
    desc: "Building high-performance applications with modern frameworks and clean architecture."
  },
  {
    icon: "🎨",
    title: "Clean Design",
    desc: "Creating visually polished interfaces with attention to detail and user experience."
  },
  {
    icon: "🔧",
    title: "Full Stack",
    desc: "End-to-end development from database design to frontend implementation."
  },
  {
    icon: "🚀",
    title: "Always Learning",
    desc: "Continuously expanding skills in new technologies and development methodologies."
  }
];
---

<BaseLayout lang="en" title={profile.fullName} description={`${profile.tagline.en} · ${profile.subtitle.en}`}>
  <!-- Navigation -->
  <nav class="nav">
    <a href="/" class="nav-logo">straiko</a>
    <div class="nav-controls">
      <a href="/ru/" class="nav-btn">RU</a>
      <button id="themeToggle" class="nav-btn" aria-label="Toggle theme">
        <span class="theme-icon">🌙</span>
      </button>
    </div>
  </nav>

  <!-- Hero -->
  <section class="hero">
    <div class="hero-badge">Open for opportunities</div>
    <h1 class="hero-title">Daniil Starikov</h1>
    <p class="hero-subtitle">IT Student & Developer building fast, modern, and highly visual applications. Currently focused on full-stack development and system architecture.</p>
    <div class="hero-links">
      <a href="https://github.com/Straiko" target="_blank" rel="noreferrer" class="hero-link">
        GitHub ↗
      </a>
      <a href="mailto:Daniilstarikov2017@gmail.com" class="hero-link hero-link-secondary">
        Contact
      </a>
    </div>
  </section>

  <!-- Features -->
  <section class="features">
    <div class="features-header">
      <h2 class="features-title">What I Do</h2>
      <p class="features-subtitle">Building modern solutions with clean code and thoughtful design</p>
    </div>
    <div class="features-grid">
      {features.map((f) => (
        <div class="feature-card">
          <div class="feature-icon">{f.icon}</div>
          <h3 class="feature-title">{f.title}</h3>
          <p class="feature-desc">{f.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Projects -->
  <section class="projects">
    <div class="projects-header">
      <h2 class="projects-title">Projects</h2>
      <p class="projects-subtitle">Selected works and open source contributions</p>
    </div>
    <div class="projects-grid">
      {projects.map((p) => (
        <div class="project-card">
          {p.badge && <span class="project-badge">{p.badge}</span>}
          <h3 class="project-title">{p.title}</h3>
          <p class="project-desc">{p.description.en}</p>
          {p.tags && (
            <div class="project-tags">
              {p.tags.map((tag) => (
                <span class="project-tag">{tag}</span>
              ))}
            </div>
          )}
          <div class="project-links">
            <a class="project-link" href={p.href} target="_blank" rel="noreferrer">
              {p.ctaLabel?.en ?? "view →"}
            </a>
            {p.liveUrl && (
              <a class="project-link project-link-live" href={p.liveUrl} target="_blank" rel="noreferrer">
                live demo →
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Skills -->
  <section class="skills">
    <div class="skills-header">
      <h2 class="skills-title">Technical Skills</h2>
      <p class="skills-subtitle">Core competencies and technologies I work with</p>
    </div>
    <div class="skills-grid">
      {skillsMap.map((sk) => (
        <div class="skill-card">
          <div class="skill-icon">{sk.icon}</div>
          <h3 class="skill-name">{sk.name}</h3>
          <div class="skill-bar">
            <div class="skill-bar-fill" style={`width: ${sk.percent}%`}></div>
          </div>
          <div class="skill-tags">
            {sk.tags.map((tg) => (
              <span class="skill-tag">{tg}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Blog -->
  {blogPosts.length > 0 && (
    <section class="blog">
      <div class="blog-header">
        <h2 class="blog-title">Blog</h2>
        <p class="blog-subtitle">Thoughts on development and learning</p>
      </div>
      <div class="blog-list">
        {blogPosts.map((post) => (
          <a href={`/blog/${post.slug}`} class="blog-item">
            <div class="blog-item-header">
              <h3 class="blog-item-title">{post.title}</h3>
              <span class="blog-item-date">{post.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
            </div>
            <p class="blog-item-desc">{post.description}</p>
            <div class="blog-item-tags">
              {post.tags?.map((tag) => (
                <span class="blog-tag">{tag}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Terminal -->
  <section class="terminal-section">
    <div class="terminal-header">
      <h2 class="terminal-title">Interactive CLI</h2>
      <p class="terminal-subtitle">Type <strong>help</strong> to see available commands</p>
    </div>
    <div class="terminal-window">
      <div class="terminal-topbar">
        <span class="terminal-dot red"></span>
        <span class="terminal-dot yellow"></span>
        <span class="terminal-dot green"></span>
      </div>
      <div id="terminal-body" class="terminal-body">
        <div class="terminal-line terminal-output-accent">Welcome to Daniil Starikov's Portfolio CLI (v2.1.0)</div>
        <div class="terminal-line">Type <span class="terminal-output-success">help</span> to view all available commands.</div>
        <div id="terminal-output-container"></div>
        <div class="terminal-input-line">
          <span class="terminal-prompt">straiko@portfolio:~$</span>
          <input type="text" id="terminal-input" class="terminal-input" autocomplete="off" spellcheck="false" aria-label="Terminal input" />
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="footer-content">
      <div class="footer-links">
        <a href="https://github.com/Straiko" target="_blank" rel="noreferrer" class="footer-link">GitHub</a>
        <a href="mailto:Daniilstarikov2017@gmail.com" class="footer-link">Email</a>
        <a href="https://github.com/Straiko?tab=repositories" target="_blank" rel="noreferrer" class="footer-link">Projects</a>
      </div>
      <p class="footer-copy">© 2026 {profile.fullName}. All rights reserved.</p>
    </div>
  </footer>

  <script is:inline>
    const themeToggle = document.getElementById('themeToggle');
    const themeIcon = themeToggle?.querySelector('.theme-icon');
    const html = document.documentElement;

    const savedTheme = localStorage.getItem('theme') || 'dark';
    html.setAttribute('data-theme', savedTheme);
    if (themeIcon) themeIcon.textContent = savedTheme === 'light' ? '🌙' : '☀️';

    themeToggle?.addEventListener('click', () => {
      const current = html.getAttribute('data-theme');
      const next = current === 'light' ? 'dark' : 'light';
      html.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      if (themeIcon) themeIcon.textContent = next === 'light' ? '🌙' : '☀️';
    });

    document.addEventListener('DOMContentLoaded', () => {
      const termInput = document.getElementById('terminal-input');
      const termOutput = document.getElementById('terminal-output-container');
      const termBody = document.getElementById('terminal-body');

      function writeLine(text, className = '') {
        const line = document.createElement('div');
        line.className = 'terminal-line ' + className;
        line.textContent = text;
        termOutput.appendChild(line);
        termBody.scrollTop = termBody.scrollHeight;
      }

      termInput?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          const cmd = termInput.value.trim().toLowerCase();
          termInput.value = '';
          if (!cmd) return;

          writeLine(`straiko@portfolio:~$ ${cmd}`, 'terminal-input-line');

          switch (cmd) {
            case 'help':
              writeLine('Available commands:', 'terminal-output-accent');
              writeLine('  about    - Information about Daniil Starikov');
              writeLine('  skills   - List of primary IT competencies');
              writeLine('  projects - View developed applications');
              writeLine('  blog     - List of recent engineering notes');
              writeLine('  contact  - Display communication handles');
              writeLine('  clear    - Clear terminal logs');
              break;
            case 'about':
              writeLine('Name: Daniil Starikov');
              writeLine('Status: IT Student at МКАГ (Moscow, Russia)');
              writeLine('Goal: Building fast, modern, and highly visual applications.');
              break;
            case 'skills':
              writeLine('IT Competencies:', 'terminal-output-accent');
              writeLine('  - Languages: Python, JavaScript, C++, C, PHP, Node.js');
              writeLine('  - Web Tech: HTML, CSS, SQL, React.js, PHP Backend');
              writeLine('  - Databases: SQL, Data Modeling, Database Design');
              writeLine('  - Network: Computer Networks, VLAN, Linux');
              break;
            case 'projects':
              writeLine('Developed projects:', 'terminal-output-accent');
              writeLine('  [1] Olympus (fast_trans) - Desktop translator with AI');
              writeLine('  [2] SHK Bot             - Telegram barcode/QR scanner');
              writeLine('  [3] easy-php             - PHP utility collection');
              writeLine('  [4] 2-work-52            - JavaScript practice tasks');
              break;
            case 'blog':
              writeLine('Recent blog entries:', 'terminal-output-accent');
              writeLine('  - Starting with Astro');
              writeLine('  - Notes on learning');
              writeLine('  - How I choose projects');
              break;
            case 'contact':
              writeLine('Contact Channels:', 'terminal-output-accent');
              writeLine('  Email: Daniilstarikov2017@gmail.com');
              writeLine('  GitHub: https://github.com/Straiko');
              break;
            case 'clear':
              termOutput.innerHTML = '';
              break;
            default:
              writeLine(`Command not found: "${cmd}". Type "help" for a list of commands.`, 'terminal-output-error');
          }
        }
      });

      document.querySelector('.terminal-window')?.addEventListener('click', () => termInput?.focus());
    });
  </script>
</BaseLayout>
