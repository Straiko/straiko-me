---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../content/profile";
import { projects } from "../content/projects";
import { getCollection } from "astro:content";

const posts = await getCollection("blog-en");
const blogPosts = posts
  .map((post) => {
    const slug = (post.slug ?? post.id).replace(/\.mdx?$/i, "");
    return {
      slug,
      title: post.data.title,
      description: post.data.description,
      pubDate: post.data.pubDate,
      tags: post.data.tags
    };
  })
  .sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());

const skillsMap = [
  { name: "Programming Languages", percent: 45, icon: "💻", tags: ["Python", "JavaScript", "C++", "C", "PHP", "Node.js"] },
  { name: "Web Technologies", percent: 60, icon: "🌐", tags: ["HTML", "CSS", "SQL", "React.js", "PHP"] },
  { name: "Databases & Design", percent: 70, icon: "🗄️", tags: ["SQL", "Data Modeling", "Database Design"] },
  { name: "Networks & Infrastructure", percent: 40, icon: "🔌", tags: ["Computer Networks", "VLAN", "Hardware", "Linux"] },
  { name: "Architecture & UML", percent: 80, icon: "🏗️", tags: ["UML Diagrams", "Use Cases", "System Design"] },
  { name: "Dev Tools", percent: 40, icon: "🔧", tags: ["Git", "CLI Tools", "Astro", "Node.js"] }
];

const features = [
  {
    icon: "⚡",
    title: "Fast Development",
    desc: "Building high-performance applications with modern frameworks and clean architecture."
  },
  {
    icon: "🎨",
    title: "Clean Design",
    desc: "Creating visually polished interfaces with attention to detail and user experience."
  },
  {
    icon: "🔧",
    title: "Full Stack",
    desc: "End-to-end development from database design to frontend implementation."
  },
  {
    icon: "🚀",
    title: "Always Learning",
    desc: "Continuously expanding skills in new technologies and development methodologies."
  }
];

const base = import.meta.env.BASE_URL;
const baseNoSlash = base.endsWith("/") ? base.slice(0, -1) : base;
---

<BaseLayout lang="en" title={profile.fullName} description={`${profile.tagline.en} · ${profile.subtitle.en}`}>
  <!-- Navigation -->
  <nav class="nav">
    <a href={`${baseNoSlash}/`} class="nav-logo">straiko</a>
    <div class="nav-controls">
      <a href={`${baseNoSlash}/resume/`} class="nav-btn">Resume</a>
      <a href={`${baseNoSlash}/ru/`} class="nav-btn">RU</a>
      <button id="themeToggle" class="nav-btn" aria-label="Toggle theme">
        <span class="theme-icon">🌙</span>
      </button>
    </div>
  </nav>

  <!-- Hero -->
  <section class="hero">
    <div class="hero-badge">Open for opportunities</div>
    <h1 class="hero-title">Daniil Starikov</h1>
    <p class="hero-subtitle">Software & Automation Developer building high-performance, robust applications. Specializing in Python, desktop engineering, AI integrations, and C#.</p>
    <div class="hero-links">
      <a href={`${baseNoSlash}/resume/`} class="hero-link">
        📄 Resume / CV
      </a>
      <a href="https://t.me/Gram_vvallet" target="_blank" rel="noreferrer" class="hero-link hero-link-secondary">
        Telegram ↗
      </a>
      <a href="https://github.com/Straiko" target="_blank" rel="noreferrer" class="hero-link hero-link-secondary">
        GitHub ↗
      </a>
      <a href="mailto:Daniilstarikov2017@gmail.com" class="hero-link hero-link-secondary">
        Contact
      </a>
    </div>
  </section>

  <!-- Features -->
  <section class="features">
    <div class="features-header">
      <h2 class="features-title">What I Do</h2>
      <p class="features-subtitle">Building modern solutions with clean code and thoughtful design</p>
    </div>
    <div class="features-grid">
      {features.map((f) => (
        <div class="feature-card">
          <div class="feature-icon">{f.icon}</div>
          <h3 class="feature-title">{f.title}</h3>
          <p class="feature-desc">{f.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Projects -->
  <section class="projects">
    <div class="projects-header">
      <h2 class="projects-title">Projects</h2>
      <p class="projects-subtitle">Selected works and open source contributions</p>
    </div>
    <div class="projects-grid">
      {projects.map((p) => (
        <div class="project-card">
          {p.badge && <span class="project-badge">{p.badge}</span>}
          <h3 class="project-title">{p.title}</h3>
          <p class="project-desc">{p.description.en}</p>
          {p.tags && (
            <div class="project-tags">
              {p.tags.map((tag) => (
                <span class="project-tag">{tag}</span>
              ))}
            </div>
          )}
          <div class="project-links">
            <a class="project-link" href={p.href} target="_blank" rel="noreferrer">
              {p.ctaLabel?.en ?? "view →"}
            </a>
            {p.liveUrl && (
              <a class="project-link project-link-live" href={p.liveUrl} target="_blank" rel="noreferrer">
                live demo →
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Skills -->
  <section class="skills">
    <div class="skills-header">
      <h2 class="skills-title">Technical Skills</h2>
      <p class="skills-subtitle">Core competencies and technologies I work with</p>
    </div>
    <div class="skills-grid">
      {skillsMap.map((sk) => (
        <div class="skill-card">
          <div class="skill-icon">{sk.icon}</div>
          <h3 class="skill-name">{sk.name}</h3>
          <div class="skill-bar">
            <div class="skill-bar-fill" style={`width: ${sk.percent}%`}></div>
          </div>
          <div class="skill-tags">
            {sk.tags.map((tg) => (
              <span class="skill-tag">{tg}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Blog -->
  {blogPosts.length > 0 && (
    <section class="blog">
      <div class="blog-header">
        <h2 class="blog-title">Blog</h2>
        <p class="blog-subtitle">Thoughts on development and learning</p>
      </div>
      <div class="blog-list">
        {blogPosts.map((post) => (
          <a href={`${baseNoSlash}/blog/${post.slug}`} class="blog-item">
            <div class="blog-item-header">
              <h3 class="blog-item-title">{post.title}</h3>
              <span class="blog-item-date">{post.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
            </div>
            <p class="blog-item-desc">{post.description}</p>
            <div class="blog-item-tags">
              {post.tags?.map((tag) => (
                <span class="blog-tag">{tag}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- For Employers -->
  <section class="hiring-section">
    <div class="hiring-header">
      <div class="hiring-pill">Available for hire</div>
      <h2 class="hiring-title">What I Bring to Your Team</h2>
      <p class="hiring-subtitle">Why engineering teams hire me: code reliability, autonomy, and shipping production-grade solutions</p>
    </div>

    <!-- Quality Metrics -->
    <div class="hiring-metrics">
      <div class="metric-card">
        <div class="metric-num">105+</div>
        <div class="metric-label">Automated Tests</div>
        <div class="metric-sub">100% pass rate with pytest</div>
      </div>
      <div class="metric-card">
        <div class="metric-num">Type-Safe</div>
        <div class="metric-label">Strict Static Typing</div>
        <div class="metric-sub">MyPy & Ruff CI linting</div>
      </div>
      <div class="metric-card">
        <div class="metric-num">CI/CD</div>
        <div class="metric-label">Automated Releases</div>
        <div class="metric-sub">Standalone binaries & installers</div>
      </div>
      <div class="metric-card">
        <div class="metric-num">Full-Cycle</div>
        <div class="metric-label">Idea to Delivery</div>
        <div class="metric-sub">Architecture, GUI, DB, APIs & packaging</div>
      </div>
    </div>

    <!-- Value Cards -->
    <div class="hiring-grid">
      <div class="hiring-card">
        <div class="hiring-icon">🎯</div>
        <h3 class="hiring-card-title">Engineering Discipline</h3>
        <p class="hiring-card-desc">
          I don't write fragile scripts. I design clean modular architectures, separate concerns, maintain thorough documentation, and always back features with automated tests.
        </p>
      </div>

      <div class="hiring-card">
        <div class="hiring-icon">⚡</div>
        <h3 class="hiring-card-title">Real Business Utility</h3>
        <p class="hiring-card-desc">
          Practical experience building end-to-end services: OCR barcode scanners for warehouse logistics, Telegram bots with LLM integration, audio pipelines, and desktop apps.
        </p>
      </div>

      <div class="hiring-card">
        <div class="hiring-icon">🔬</div>
        <h3 class="hiring-card-title">Low-Level System Knowledge</h3>
        <p class="hiring-card-desc">
          Deep understanding of OS mechanisms and runtimes: global keyboard hooks, audio capture, clipboard recovery, and decompiling .NET assemblies via Reflection.
        </p>
      </div>

      <div class="hiring-card">
        <div class="hiring-icon">🤝</div>
        <h3 class="hiring-card-title">Fast Onboarding & Autonomy</h3>
        <p class="hiring-card-desc">
          Comfortable exploring unfamiliar APIs and large codebases independently. Quick to adapt to team workflows and ready to complete a test assignment.
        </p>
      </div>
    </div>

    <!-- CTA -->
    <div class="hiring-cta">
      <div class="hiring-cta-content">
        <h3 class="hiring-cta-title">Looking for a strong developer?</h3>
        <p class="hiring-cta-desc">Open for Full-time opportunities (Remote or Hybrid in Moscow).</p>
      </div>
      <div class="hiring-cta-buttons">
        <a href="https://t.me/Gram_vvallet" target="_blank" rel="noreferrer" class="cta-btn cta-btn-tg">
          Message on Telegram ↗
        </a>
        <a href={`${baseNoSlash}/resume/`} class="cta-btn cta-btn-resume">
          View Resume
        </a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="footer-content">
      <div class="footer-links">
        <a href="https://t.me/Gram_vvallet" target="_blank" rel="noreferrer" class="footer-link">Telegram</a>
        <a href="https://github.com/Straiko" target="_blank" rel="noreferrer" class="footer-link">GitHub</a>
        <a href="mailto:Daniilstarikov2017@gmail.com" class="footer-link">Email</a>
        <a href={`${baseNoSlash}/resume/`} class="footer-link">Resume</a>
      </div>
      <p class="footer-copy">© 2026 {profile.fullName}. All rights reserved.</p>
    </div>
  </footer>

  <script is:inline>
    (function() {
      var saved = localStorage.getItem('lang');
      if (saved) return;
      var nav = navigator.language || navigator.userLanguage || '';
      if (nav.toLowerCase().startsWith('ru')) {
        var base = document.documentElement.getAttribute('data-base') || '';
        window.location.replace(base + '/ru/');
      }
    })();

    const themeToggle = document.getElementById('themeToggle');
    const themeIcon = themeToggle?.querySelector('.theme-icon');
    const html = document.documentElement;

    const savedTheme = localStorage.getItem('theme') || 'dark';
    html.setAttribute('data-theme', savedTheme);
    if (themeIcon) themeIcon.textContent = savedTheme === 'light' ? '🌙' : '☀️';

    themeToggle?.addEventListener('click', () => {
      const current = html.getAttribute('data-theme');
      const next = current === 'light' ? 'dark' : 'light';
      html.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      if (themeIcon) themeIcon.textContent = next === 'light' ? '🌙' : '☀️';
    });
  </script>
</BaseLayout>
