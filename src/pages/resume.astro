---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../content/profile";
import "../styles/resume.css";

const base = import.meta.env.BASE_URL;
const baseNoSlash = base.endsWith("/") ? base.slice(0, -1) : base;
const withBase = (p: string) => `${baseNoSlash}${p}`;
---

<BaseLayout lang="en" title="Resume — Daniil Starikov" description="Resume of Software Engineer specializing in Python, C#, PyQt6, AI APIs, Linux.">
  <!-- Navigation -->
  <nav class="nav">
    <a href={`${baseNoSlash}/`} class="nav-logo">straiko</a>
    <div class="nav-controls">
      <a href={withBase("/Daniil_Starikov_Resume.pdf")} download="Daniil_Starikov_Resume.pdf" class="nav-btn nav-btn-primary">
        ↓ Download PDF
      </a>
      <a href={`${baseNoSlash}/ru/resume/`} class="nav-btn" data-lang-switch="ru">RU</a>
      <a href={`${baseNoSlash}/`} class="nav-btn">Home</a>
      <button id="themeToggle" class="nav-btn" aria-label="Toggle theme">
        <span class="theme-icon">🌙</span>
      </button>
    </div>
  </nav>

  <main class="resume-wrapper">
    <!-- Header -->
    <header class="resume-hero">
      <div class="resume-badge">Indie Developer · Available for hire</div>
      <h1 class="resume-name">Daniil Starikov</h1>
      <p class="resume-role">Indie Developer / Python & C# Software Engineer</p>
      <p class="resume-location">📍 Moscow, Russia · Open to remote work / hybrid</p>

      <div class="resume-contacts">
        <a href="https://t.me/Gram_vvallet" target="_blank" rel="noreferrer" class="contact-pill">
          <span class="contact-icon">✈️</span> Telegram: @Gram_vvallet
        </a>
        <a href="mailto:Daniilstarikov2017@gmail.com" class="contact-pill">
          <span class="contact-icon">✉️</span> Daniilstarikov2017@gmail.com
        </a>
        <a href="https://github.com/Straiko" target="_blank" rel="noreferrer" class="contact-pill">
          <span class="contact-icon">🐙</span> GitHub: @Straiko
        </a>
        <a href="https://straiko.github.io/straiko-me/" target="_blank" rel="noreferrer" class="contact-pill">
          <span class="contact-icon">🌐</span> straiko.github.io/straiko-me
        </a>
      </div>
    </header>

    <!-- About Me -->
    <section class="resume-section">
      <div class="section-badge">About Me</div>
      <div class="resume-card resume-about-card">
        <p>
          <strong>Indie Developer & Software Engineer</strong> specializing in <strong>Python</strong> and <strong>C# / .NET</strong>. I build, test, and ship complete standalone software products: desktop tools, Telegram bots, LLM integrations, and OCR services.
        </p>
        <p style="margin-top: 0.75rem;">
          Indie engineering has trained me to take full ownership of every product lifecycle stage: from architectural design to test coverage (<strong>105+ pytest tests</strong>), static typing (<strong>mypy</strong>), automated delivery pipelines (<strong>GitHub Actions CI/CD</strong>), and cross-platform packaging for Windows and Linux. Highly proficient in Linux environments and runtime reverse engineering.
        </p>
      </div>
    </section>

    <!-- Technical Skills -->
    <section class="resume-section">
      <div class="section-badge">Technical Skills</div>
      <div class="skills-layout">
        <div class="skill-box">
          <div class="skill-box-title">💻 Languages</div>
          <div class="skill-box-desc">Python 3.10+, C# (.NET), SQL, JavaScript / TypeScript, Bash, PHP, basic Rust</div>
        </div>
        <div class="skill-box">
          <div class="skill-box-title">🖥️ Desktop & Systems</div>
          <div class="skill-box-desc">PyQt6, Qt Designer, Win32 API, Linux Input, Global Hotkeys, Clipboard, System Tray</div>
        </div>
        <div class="skill-box">
          <div class="skill-box-title">🤖 Audio, Vision & AI</div>
          <div class="skill-box-desc">Speech Recognition (STT), Audio Capture, OCR (Code128 / QR), OpenAI, Anthropic, Groq, Ollama</div>
        </div>
        <div class="skill-box">
          <div class="skill-box-title">🧪 Quality & Testing</div>
          <div class="skill-box-desc">Pytest (105+ tests), MyPy (strict types), Ruff, Pre-commit, Git, Conventional Commits</div>
        </div>
        <div class="skill-box">
          <div class="skill-box-title">🚀 CI/CD & Packaging</div>
          <div class="skill-box-desc">GitHub Actions, PyInstaller (standalone builds), Inno Setup (Windows installers)</div>
        </div>
        <div class="skill-box">
          <div class="skill-box-title">⚙️ Reverse Engineering & Engines</div>
          <div class="skill-box-desc">.NET Reflection, Unity assembly analysis (IL/C#), XPath/XML patching, engine modding</div>
        </div>
        <div class="skill-box">
          <div class="skill-box-title">📱 Bots & Web</div>
          <div class="skill-box-desc">Telegram Bot API (aiogram), Telegram Web Apps (TWA), VK API, Astro, HTML/CSS/JS, React.js</div>
        </div>
        <div class="skill-box">
          <div class="skill-box-title">🗄️ Databases & Infrastructure</div>
          <div class="skill-box-desc">Database Design, SQL, 1C:Enterprise 8, Linux (Wayland/X11), Networking, VLANs</div>
        </div>
      </div>
    </section>

    <!-- Projects -->
    <section class="resume-section">
      <div class="section-badge">Featured Projects</div>
      <div class="projects-stack">

        <!-- Project 1: Olympus -->
        <article class="resume-card project-entry">
          <div class="project-top">
            <h3 class="project-name">Olympus (fast_trans) — Multimodal Desktop Translation & Voice Assistant</h3>
            <span class="project-pill">Python · PyQt6 · CI/CD</span>
          </div>
          <div class="project-sublinks">
            <a href="https://github.com/Straiko/fast_trans" target="_blank" rel="noreferrer">🐙 GitHub Repository ↗</a>
            <span class="dot-sep">•</span>
            <a href="https://straiko.github.io/fast_trans/" target="_blank" rel="noreferrer">🌐 Project Landing ↗</a>
          </div>
          <ul class="project-list">
            <li>Designed a modular desktop application for instant text translation and voice input with AI text optimization.</li>
            <li>Implemented low-level global hotkey listeners and text substitution in active third-party windows with clipboard preservation.</li>
            <li>Built an audio pipeline: dynamic microphone selection, stream capture, speech-to-text (STT), AI error correction, and instant translation.</li>
            <li>Engineered for production reliability: <strong>105+ automated tests (pytest)</strong>, static type checking (<strong>MyPy</strong>), and <strong>Ruff</strong> linting.</li>
            <li>Configured <strong>GitHub Actions CI/CD</strong> for automated test execution and standalone executable / Inno Setup builds.</li>
          </ul>
        </article>

        <!-- Project 2: SHK Bot -->
        <article class="resume-card project-entry">
          <div class="project-top">
            <h3 class="project-name">SHK Bot / @Ozonbratik_bot — Barcode & QR Code OCR Generator Service</h3>
            <span class="project-pill">Python · OCR · Bots</span>
          </div>
          <div class="project-sublinks">
            <a href="https://t.me/Ozonbratik_bot" target="_blank" rel="noreferrer">✈️ Open in Telegram ↗</a>
            <span class="dot-sep">•</span>
            <a href="https://github.com/Straiko/shk" target="_blank" rel="noreferrer">🐙 GitHub Repository ↗</a>
          </div>
          <ul class="project-list">
            <li>Developed and deployed a service for scanning and generating barcodes (Code128) and QR codes.</li>
            <li>Engineered image preprocessing and OCR fallbacks for resilient reading of damaged or noisy codes.</li>
            <li>Shipped cross-platform bots (Telegram, VK, MAX) and a promotional landing page built with Astro.</li>
          </ul>
        </article>

        <!-- Project 3: Unity Modding -->
        <article class="resume-card project-entry">
          <div class="project-top">
            <h3 class="project-name">Game Engine Modding & Assembly Analysis (CryoArsenal)</h3>
            <span class="project-pill">C# · .NET · Unity · Reflection</span>
          </div>
          <ul class="project-list">
            <li>Utilized <strong>.NET Reflection</strong> to inspect compiled assemblies (<code>Assembly-CSharp.dll</code>), invoking internal members and controlling game entities.</li>
            <li>Built game extensions with custom cryo status mechanics, XUI custom components, and XPath patch configurations.</li>
          </ul>
        </article>

        <!-- Project 4: AI & Web -->
        <article class="resume-card project-entry">
          <div class="project-top">
            <h3 class="project-name">AI & Web Projects (Proverb Bot, SmartCart TWA, Exam Tickets Bot)</h3>
            <span class="project-pill">LLM · Groq · TWA · JS</span>
          </div>
          <ul class="project-list">
            <li>Created a Telegram bot integrating LLMs via Groq API for semantic proverb analysis and recommendation.</li>
            <li>Developed an interactive exam prep bot (JS, algorithms, OOP) with progress tracking and quizzes.</li>
            <li>Built a <strong>Telegram Web App (TWA)</strong> prototype and personal portfolio site on Astro.</li>
          </ul>
        </article>

      </div>
    </section>

    <!-- Education -->
    <section class="resume-section">
      <div class="resume-badge">Education</div>
      <div class="resume-card edu-card">
        <div class="edu-header">
          <div>
            <h3 class="edu-title">Moscow College of Architecture and Urban Development (MKAG)</h3>
            <p class="edu-spec">Major: 09.02.07 Information Systems and Programming</p>
          </div>
          <div class="edu-year">Moscow, Russia</div>
        </div>
        <p class="edu-desc">
          Qualification: Software Engineer / Information Systems Specialist. Focus on algorithms, object-oriented programming, relational databases, application modules, and 1C:Enterprise 8.
        </p>
      </div>
    </section>

    <!-- Download CTA -->
    <div class="resume-cta-bottom">
      <a href={withBase("/Daniil_Starikov_Resume.pdf")} download="Daniil_Starikov_Resume.pdf" class="cta-download-btn">
        <svg xmlns="http://www.w3.org/2000/svg" class="cta-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        Download Resume in PDF
      </a>
    </div>
  </main>

  <footer class="footer">
    <div class="footer-content">
      <p class="footer-copy">© 2026 {profile.fullName} · Resume</p>
    </div>
  </footer>
</BaseLayout>

