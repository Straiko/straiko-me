---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog-en")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const base = import.meta.env.BASE_URL;
const baseNoTrail = base.endsWith("/") ? base.slice(0, -1) : base;
const withBase = (p) => `${baseNoTrail}${p}`;
const assetSrc = (src) => (src?.startsWith("/") ? withBase(src) : src);
---

<BaseLayout lang="en" title="Blog" description="Notes, opinions, and small write-ups.">
	<div class="min-h-screen">
		<div class="blog-post">
			<header class="post-header">
				<a class="back-link" href={withBase("/")}>← Back to home</a>
				<h1 class="post-title">Blog</h1>
				<p style="color: var(--text-secondary); font-size: 1.1rem; line-height: 1.6;">Notes, opinions, and small write-ups.</p>
			</header>

			<section style="border-top: 1px solid var(--border-color); padding-top: 2.5rem; display: flex; flex-direction: column; gap: 2rem;">
				{posts.map((post) => {
					const slug = (post.slug ?? post.id).replace(/\.mdx?$/i, "");
					return (
						<article class="blog-item">
							<div class="blog-item-header">
								<h2 class="blog-item-title">
									<a href={withBase(`/blog/${slug}/`)}>
										{post.data.title}
									</a>
								</h2>
								<time class="blog-item-date" datetime={post.data.pubDate.toISOString()}>
									{post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
								</time>
							</div>
							<p class="blog-item-description">{post.data.description}</p>
							<div class="blog-item-tags">
								{post.data.tags?.map((t) => (
									<span class="blog-tag">{t}</span>
								))}
							</div>
						</article>
					);
				})}
			</section>
		</div>
	</div>
</BaseLayout>
