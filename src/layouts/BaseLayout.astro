---
import "../styles/global.css";
import { profile } from "../content/profile";

type Props = {
  title: string;
  description?: string;
  lang?: "ru" | "en";
  image?: string;
};

const { title, description, lang, image } = Astro.props;

const base = import.meta.env.BASE_URL;
const baseNoTrail = base.endsWith("/") ? base.slice(0, -1) : base;
const withBase = (p: string) => `${baseNoTrail}${p}`;

const pathname = Astro.url.pathname;
const pathNoBase = baseNoTrail && pathname.startsWith(baseNoTrail) ? (pathname.slice(baseNoTrail.length) || "/") : pathname;

// Determine language strictly from prop or path
const isRu = lang === "ru" || pathNoBase.startsWith("/ru");
const isEn = !isRu;
const pageLang = isEn ? "en" : "ru";

// Compute reciprocal alternate URLs for SEO
let enPathNoBase = "/";
let ruPathNoBase = "/ru/";

if (pathNoBase.startsWith("/ru/")) {
  ruPathNoBase = pathNoBase;
  enPathNoBase = pathNoBase.replace(/^\/ru\//, "/") || "/";
} else if (pathNoBase === "/ru") {
  ruPathNoBase = "/ru/";
  enPathNoBase = "/";
} else {
  enPathNoBase = pathNoBase;
  ruPathNoBase = pathNoBase === "/" ? "/ru/" : `/ru${pathNoBase.startsWith("/") ? pathNoBase : "/" + pathNoBase}`;
}

const siteUrl = Astro.site || "https://straiko.me";
const canonicalURL = new URL(pathname, siteUrl).href;
const enAlternateURL = new URL(withBase(enPathNoBase), siteUrl).href;
const ruAlternateURL = new URL(withBase(ruPathNoBase), siteUrl).href;

const ogImage = image || withBase("/og-image.jpg");
const ogDescription = description || (isEn ? `${profile.tagline.en} · ${profile.subtitle.en}` : `${profile.tagline.ru} · ${profile.subtitle.ru}`);
---

<html lang={pageLang} data-base={baseNoTrail}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="icon" href={withBase("/favicon.ico")} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Outfit:wght@100..900&display=swap" rel="stylesheet" />
    <title>{title}</title>
    {description ? <meta name="description" content={description} /> : null}

    <!-- Canonical & Multilingual Alternates -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={enAlternateURL} />
    <link rel="alternate" hreflang="ru" href={ruAlternateURL} />
    <link rel="alternate" hreflang="x-default" href={enAlternateURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={new URL(ogImage, siteUrl).href} />
    <meta property="og:locale" content={isEn ? "en_US" : "ru_RU"} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={new URL(ogImage, siteUrl).href} />

    <!-- Additional SEO -->
    <meta name="author" content={profile.fullName} />
    <meta name="robots" content="index, follow" />

    <!-- Immediate theme initialization to prevent Flash of Unstyled Content (FOUC) -->
    <script is:inline>
      (function() {
        try {
          var stored = localStorage.getItem('theme');
          var theme = stored || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <slot />

    <!-- Shared UI controls: Theme toggle and Language persistence -->
    <script is:inline>
      (function() {
        function initThemeToggle() {
          var toggleBtn = document.getElementById('themeToggle');
          if (!toggleBtn) return;
          var icon = toggleBtn.querySelector('.theme-icon');
          var html = document.documentElement;
          function updateIcon() {
            var current = html.getAttribute('data-theme') || 'dark';
            if (icon) icon.textContent = current === 'light' ? '🌙' : '☀️';
          }
          updateIcon();
          toggleBtn.onclick = function() {
            var current = html.getAttribute('data-theme') || 'dark';
            var next = current === 'light' ? 'dark' : 'light';
            html.setAttribute('data-theme', next);
            try { localStorage.setItem('theme', next); } catch (_) {}
            updateIcon();
          };
        }

        function initLangSwitches() {
          document.querySelectorAll('[data-lang-switch]').forEach(function(el) {
            el.addEventListener('click', function() {
              var targetLang = el.getAttribute('data-lang-switch');
              if (targetLang) {
                try { localStorage.setItem('lang', targetLang); } catch (_) {}
              }
            });
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', function() {
            initThemeToggle();
            initLangSwitches();
          });
        } else {
          initThemeToggle();
          initLangSwitches();
        }
      })();
    </script>
  </body>
</html>
